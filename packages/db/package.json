{
  "name": "@repo/db",
  "version": "1.0.0",
  "description": "Type-safe PostgreSQL access layer built on Kysely with schema types, migrations, seeds and repositories",
  "author": "Rajarshi Chakraborty",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "db:migrate": "tsx src/scripts/migrate.ts latest",
    "db:rollback": "tsx src/scripts/migrate.ts rollback",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@repo/lib": "workspace:*",
    "@repo/types": "workspace:*",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "rimraf": "6.1.3",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  }
}
