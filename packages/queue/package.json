{
  "name": "@repo/queue",
  "version": "1.0.0",
  "description": "RabbitMQ client with durable queues, publisher confirms, dead letter queues and typed message handlers",
  "author": "Rajarshi Chakraborty",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@repo/lib": "workspace:*",
    "@repo/types": "workspace:*",
    "amqplib": "2.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "rimraf": "6.1.3",
    "tsup": "9.0.0",
    "typescript": "5.9.2"
  }
}
