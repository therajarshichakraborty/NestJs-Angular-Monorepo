
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{html,css,scss,less}]
indent_size = 2

[*.py]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,pdf,woff,woff2,ttf,eot}]
charset = unset
insert_final_newline = unset
