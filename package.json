{
  "name": "nestjs-angular-monorepo",
  "version": "1.0.0",
  "description": "Turborepo monorepo with a NestJS API, an Angular web app and shared packages",
  "author": "Rajarshi Chakraborty",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -- turbo run dev",
    "dev:api": "dotenv -- turbo run dev --filter=@api...",
    "dev:web": "dotenv -- turbo run dev --filter=@web...",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,html,css,md}\"",
    "db:migrate": "dotenv -- turbo run db:migrate",
    "db:rollback": "dotenv -- turbo run db:rollback",
    "db:seed": "dotenv -- turbo run db:seed",
    "packages:install": "pnpm install --filter \"./packages/**\"",
    "apps:install": "pnpm install --filter \"./apps/**\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  }
}
